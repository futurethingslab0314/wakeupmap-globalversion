{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/stamp-wakeuphere-version.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:server": "tsx --test src/server/__tests__/*.test.ts",
    "test:wakeuphere-update": "node --test tests/wakeuphere-update.test.mjs",
    "test:wakeuphere-alarm": "node --test tests/wakeuphere-alarm*.test.mjs",
    "test:wakeuphere-bookings": "node --import tsx --test tests/wakeuphere-bookings.test.ts tests/wakeuphere-booking-client.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@notionhq/client": "^5.14.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
