{
  "functions": {
    "api/wake-up-now.ts": {
      "includeFiles": "cities_data.json",
      "maxDuration": 60
    },
    "api/wakeuphere.ts": {
      "includeFiles": "cities_data.json",
      "maxDuration": 60
    },
    "api/wake-up-image.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/wakeuphere/(.*)",
      "destination": "/wakeuphere/$1"
    },
    {
      "source": "/((?!api/|wakeuphere/).*)",
      "destination": "/index.html"
    }
  ]
}
